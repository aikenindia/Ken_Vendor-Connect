# Ken Vendor Connect WhatsApp Business Cloud API configuration
# Copy this file to .env if you prefer backend-local configuration.
# The project root .env is also loaded automatically.

WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_account_id_here
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here
WHATSAPP_API_VERSION=v21.0

# Optional AI configuration used for vendor quote parsing.
OPENROUTER_API_KEY=your_openrouter_api_key_here